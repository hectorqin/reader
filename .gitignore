# dependencies
node_modules/
*.tgz

# build output
server/dist/
web/dist/

# runtime data: sqlite db, covers, token secret
data/
server/data/

# logs and local env
*.log
.env
.env.local

# editor / OS
.DS_Store
.idea/
.vscode/

# web client build output (regenerated by `npm run build`)
web/dist/

# UI review screenshots: regenerated by `npm run ui:review`, and a binary diff on
# every run is noise in a review. The *report* is committed — that is the part a
# reviewer reads, and the part CI asserts on.
docs/ui-review/*.png
docs/ui-review/mobile/*.png
