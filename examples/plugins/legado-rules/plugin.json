{
  "id": "reader.source.legado",
  "name": "Legado rule sources",
  "version": "0.2.0",
  "apiVersion": 1,
  "runtime": "node",
  "entry": "main.mjs",
  "sourceTypes": [
    {
      "id": "legado-rules",
      "label": "Legado 规则书源",
      "capabilities": ["search", "detail", "acquire.chapters", "content.manifest", "content.resource"],
      "configSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "title": "书源",
            "default": "biquge99",
            "enum": ["biquge99", "biquw", "92xs", "biqusk", "wujixsw", "00shu"],
            "enumNames": [
              "笔趣阁③（biquge99.cc）",
              "笔趣网（biquw.info）",
              "就爱文学（92xs.info）",
              "必去书库（biqusk.com）",
              "无极小说（wujixsw.info）",
              "零零小说（00shu.la）"
            ]
          }
        },
        "required": ["sourceId"],
        "additionalProperties": false
      }
    }
  ],
  "permissions": {
    "network": {
      "domains": [
        "biquge99.cc",
        "www.biquge99.cc",
        "www.biqvge99.cc",
        "biquw.info",
        "www.biquw.info",
        "92xs.info",
        "www.92xs.info",
        "biqusk.com",
        "www.biqusk.com",
        "wujixsw.info",
        "00shu.la",
        "www.00shu.la"
      ]
    }
  }
}
