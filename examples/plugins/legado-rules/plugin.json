{
  "id": "reader.source.legado",
  "name": "Legado rule sources",
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": "node",
  "entry": "main.mjs",
  "sourceTypes": [
    {
      "id": "legado-rules",
      "label": "Legado 规则书源",
      "capabilities": ["search", "detail", "acquire.chapters", "content.manifest", "content.resource"],
      "configSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "title": "书源",
            "default": "biquge99",
            "enum": ["biquge99"],
            "enumNames": ["笔趣阁③（biquge99.cc）"]
          }
        },
        "required": ["sourceId"],
        "additionalProperties": false
      }
    }
  ],
  "permissions": {
    "network": { "domains": ["biquge99.cc", "www.biquge99.cc", "www.biqvge99.cc"] }
  }
}
