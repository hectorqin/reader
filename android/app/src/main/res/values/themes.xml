<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The native theme exists only for the split second before the WebView has
      painted. It matches the web client's default paper colour so there is no
      flash of a different background on launch.
    -->
    <style name="Theme.Reader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Reader.Video" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#080C09</item>
        <item name="android:statusBarColor">#080C09</item>
        <item name="android:navigationBarColor">#080C09</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorAccent">#B6C99A</item>
    </style>
</resources>
