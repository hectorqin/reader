# Build output
build/
app/build/
.gradle/
local.properties

# The staged web bundle is generated by scripts/build-web-assets.sh and copied
# out of web/dist. Committing it would put a built artifact under version control
# and make every client change show up twice in review.
app/src/main/assets/web-assets/*
!app/src/main/assets/web-assets/README.txt

# Keystores and signing material must never be committed.
*.jks
*.keystore
keystore.properties
